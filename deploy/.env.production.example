# Production settings of Pagebuilder. Copy to /var/www/pagebuilder/shared/.env
# and fill in the values marked "change". Generate the key once: php artisan key:generate

APP_NAME=Pagebuilder
APP_ENV=production
APP_KEY=                                  # change
APP_DEBUG=false
APP_URL=https://pagebuilder.example       # change: the admin domain

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pagebuilder
DB_USERNAME=pagebuilder                   # change: not root
DB_PASSWORD=                              # change

# Sessions: host-only cookies (SESSION_DOMAIN empty), so the admin session never
# reaches company subdomains and each site has its own visitor session.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# The admin SPA's domain(s) for Sanctum cookie authentication.
SANCTUM_STATEFUL_DOMAINS=pagebuilder.example   # change

# Redis for cache (page cache, rate limits), sessions and the queue.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=                                # change
MAIL_PORT=587
MAIL_USERNAME=                            # change
MAIL_PASSWORD=                            # change
MAIL_FROM_ADDRESS=noreply@pagebuilder.example
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
MEDIA_DISK=public

# Company sites: {slug}.TENANT_SITE_DOMAIN (wildcard DNS and certificate needed).
TENANT_SITE_DOMAIN=pagebuilder.example    # change
TENANT_SITE_SCHEME=https

SITE_SSR_ENABLED=true
SITE_SSR_URL=http://127.0.0.1:13714/render
SITE_PAGE_CACHE=true
SITE_PAGE_CACHE_TTL=3600

# Captcha of site forms: yandex (SmartCaptcha), turnstile (Cloudflare) or none.
CAPTCHA_PROVIDER=none
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
# /site/{slug} on the admin domain redirects to the real site in production.
SITE_PREVIEW_PATH=false
MAX_COMPANIES_PER_USER=10

# Only used by `php artisan db:seed --class=SuperAdminSeeder` on the first install.
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL=admin@pagebuilder.example   # change
SUPERADMIN_PASSWORD=                         # change: long and unique
SUPERADMIN_COMPANY="Main Company"
